// The tower's nav. This file REPLACES the framework's packaged
// backend/sections/sidebar.json wholesale (first-layer-wins on the _includes
// layer) - the markup, the CSS, the rail collapse and the mobile drawer all
// stay OMEGA's; only the data is ours.
//
// It is the BACKEND spelling, not the admin one, because the layout that picks
// between them keys off the URL: themes/base/_layouts/backend/core/base.html
// includes admin/sections/sidebar.html only when `page.url contains "/admin"`.
// The tower's pages live at clean top-level URLs (/, /board, /crew…), so the
// backend pair is what renders. Both spellings feed the SAME markup include
// (global/sections/app-sidebar.html), so nothing is lost by not being "admin".
//
// The project switch is the framework's SELECTOR module, enabled here and
// filled at runtime: the theme draws the button and its dropdown above the nav,
// and the page JS writes the menu into it (libs/tower/sidebar.js) from the same
// `repos` feed the pages read - an All projects master row and one row per
// repo, each row carrying the box that puts it in a subset (issue #168, one
// list rather than two). Nothing about the roster can be baked, since
// this file is built once and the roster is whatever repos are on the machine
// when the page is open; the one dropdown item below is the placeholder that
// makes Liquid ship the `ul` for the JS to fill. The choice is held in
// `?repo=`, which the page JS also writes onto every link below so it survives
// the nav (issue #104).
{
  logo: {
    href: '/',
    class: 'filter-adaptive',
  },
  selector: {
    enabled: true,
    name: 'All projects',
    env: 'every repo on the roster',
    dropdown: [
      {
        label: 'All projects',
        href: '#',
      },
    ],
  },
  links: [
    {
      header: true,
      label: 'Mission control',
    },
    {
      label: 'Overview',
      href: '/',
      icon: 'gauge-high',
    },
    {
      // bars-progress, not table-columns: the rail's own collapse button
      // draws the columns glyph, and two of one icon reads as one control
      // (issue #177).
      label: 'Board',
      href: '/board',
      icon: 'bars-progress',
    },
    {
      label: 'Crew',
      href: '/crew',
      icon: 'sitemap',
    },
    {
      label: 'Usage',
      href: '/usage',
      icon: 'chart-simple',
    },
    {
      label: 'Brief',
      href: '/brief',
      icon: 'newspaper',
    },
    {
      // Last in its group by charter (issue #177): Health is the page for
      // what is broken, and the quiet days should not put it above the work.
      label: 'Health',
      href: '/health',
      icon: 'heart-pulse',
    },
    // Its own group, because it is the one page that is not a view of the
    // board: it holds the GitHub token this browser reads GitHub with, which
    // is what a published copy has instead of a tower (issue #167). It is also
    // the one page a copy with no token can use, and the runtime sends a
    // tokenless landing here.
    {
      header: true,
      label: 'This browser',
    },
    {
      label: 'Settings',
      href: '/settings',
      icon: 'gear',
    },
  ],
}
