# The tower app is its own npm root and its own OMEGA brand root, so it carries
# its own ignore rules - the same set omega-brand uses. Two separate derived
# trees have to be named (dist/ and .omega/), which is why this lives here
# rather than as one line in the repo root's .gitignore.

# Dependencies
node_modules/
package-lock.json

# Build output + machinery (omega build / omega dev)
dist/
.omega/
.cache/
.temp/

# Secrets: .env and the environment overlays beside it. The example is the
# template the README points at, a secret in shape and not in content.
.env
.env.*
!.env.example

# Run logs (truncated on every launch - never committed)
logs/
