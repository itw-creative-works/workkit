// The tower's brand layer. The tower authors brand, theme and targets. Every
// other section is the manage walk's copy of a schema default (@omega.js/config
// src/defaults.js). The `omega dev` boot lane writes any default this file
// lacks. A block removed here reappears on the next `npm run tower`. The file
// is kept converged, so that boot leaves the tree clean. Only brand.id
// and brand.name are required by the schema. The tower is a localhost tool
// with no cloud project.
//
// LOCAL ERA: every @omega.js/* dependency is a relative file: spec into the
// sibling Omega checkout (see tower/app/README.md). The specs flip to registry
// ranges when OMEGA publishes.
{
  brand: {
    id: "workkit",
    name: "Tower",
    description: "Mission control for the workkit issue workflow - the board, the crew, token usage, repo health, and the daily brief.",

    // The one hex (issue #53, blue since #149): the framework composes both
    // themes' accent ramps from it at build time (src/brand-tokens.js), so
    // recoloring the whole dashboard is this line and no CSS. The authored
    // brandmark is drawn in the same hex - one brand colour, not two.
    color: "#2563EB",

    images: {
      // The mark is authored ONCE, at assets/logo/brandmark.svg; the assets
      // service mints the variants into the gitignored .omega/assets and the
      // web build's static channel bridges them to this path. The key is not
      // auto-set by the mint - without it the sidebar stays text-only.
      brandmark: "/assets/images/brand/brandmark.svg",
      // The social preview: og/twitter tags fall back to the brandmark, an
      // SVG no platform renders - this points them at the minted PNG instead.
      social: "/assets/images/brand/social.png",
    },
  },
  // No repo block: its presence is the switch for the repo service, and it
  // would derive a `workkit-omega` source repo to reconcile. The tower's source
  // is workkit's own repo, which the manager never touches.
  edge: {
    providers: {
      // Cloudflare zone reconciliation (@omega.js/manager cloudflare service):
      // dns, settings, rules, cacheRules, speedTest, workers. Tokens live in
      // .env.
      cloudflare: {
        // false = the edge service skips entirely: no zone, DNS, settings,
        // rules, speed-test or worker reconciliation for this brand.
        enabled: true,
      },
    },
  },
  cloud: {
    // true = the cloud project is shared with other brands; only per-brand
    // operations run (service-account, sdk-config).
    shared: false,
    // false = skip the api.{domain} hosting custom domain.
    apiSubdomain: true,
  },
  monitoring: {
    // Role-level switch (default true). false skips the monitoring service
    // outright, whatever the providers block says.
    enabled: true,
  },
  payment: {
    winback: {
      // The cancel-flow save offer (#268), shown before the cancellation
      // questionnaire. Defaults ON: false is the whole off switch, and the
      // cancel flow goes straight to the questionnaire.
      enabled: true,
      // Whole percentage off the next cycle the save offer pitches. Defaults to
      // 50. Mutually exclusive with payment.winback.amount.
      percent: 50,
      // How long the accepted offer lasts: 'once' (the next cycle only, the
      // default) or 'forever' (a permanent price cut).
      duration: "once",
    },
    // The ISO 4217 code every price in payment.products is quoted in (#850).
    // One currency per brand, named wherever a price is shown or recorded: the
    // pricing page's JSON-LD, the checkout, and the backend's order history
    // (GET /user/orders). Defaults to 'USD', the fallback its readers carried
    // before the fact had a home. The successor to the retired
    // targets.web.currency.
    currency: "USD",
    providers: {
      coinbase: {
        // Coinbase Commerce (crypto) checkout, one-time purchases only. Its
        // ONLY credential is a secret (COINBASE_COMMERCE_API_KEY), so there is
        // no public datum to gate on: this is the switch, default OFF, because
        // an accidental ON shows a Crypto button no key can complete.
        enabled: false,
      },
    },
  },
  // Marketing automation: the campaigns + newsletter roles (each
  // provider-keyed) and the prune switch.
  marketing: {
    campaigns: {
      // Role-level switch for email marketing (default true). false skips the
      // campaigns service and the backend contact sync.
      enabled: true,
    },
    newsletter: {
      // Role-level switch for the newsletter (default true). false skips the
      // newsletter service and the backend subscriber sync.
      enabled: true,
    },
    prune: {
      // Monthly cold-contact prune across both providers. ON by default (Ian
      // 2026-08-22) and materialized into every brand config: false is the
      // per-brand off switch.
      enabled: true,
    },
  },
  search: {
    providers: {
      searchConsole: {
        // false = the search service skips entirely: the property is never
        // verified and no sitemap is submitted (submitSitemap only turns the
        // sitemap half off).
        enabled: true,
        // false = skip sitemap submission to Google Search Console.
        submitSitemap: true,
        // Sitemap paths submitted as https://{domain}{path} (default
        // ['/sitemap.xml']).
        sitemapPaths: ["/sitemap.xml"],
      },
    },
  },
  forms: {
    providers: {
      slapform: {
        // false = the slapform service skips and the contact page has no form
        // endpoint.
        enabled: true,
        // false = the form is shared and managed by another brand; its
        // name/settings are left alone.
        updateFormInfo: true,
        // Tier granted to the form-owner account ({ id, name }):
        // Slapform-operator only.
        plan: {
          id: "grandmaster",
          name: "Grandmaster",
        },
      },
    },
  },
  inbound: {
    chat: {
      providers: {
        chatsy: {
          // false = no chat widget boots and the chatsy service skips.
          enabled: true,
          // false = the agent is shared and managed by another brand; its
          // settings/knowledge are left alone.
          updateAgentInfo: true,
          // Tier granted to the agent-owner account ({ id, name }):
          // Chatsy-operator only.
          plan: {
            id: "max",
            name: "Max",
          },
        },
      },
    },
    email: {
      providers: {
        replyify: {
          // false = the replyify service skips.
          enabled: true,
          // false = the agent is shared and managed by another brand; its
          // filter/knowledge are left alone.
          updateAgentInfo: true,
          // Tier granted to the agent-owner account ({ id, name }):
          // Replyify-operator only.
          plan: {
            id: "max",
            name: "Max",
          },
        },
      },
    },
  },
  // Directory participation (@omega.js/manager directory service): { enabled }.
  // Opt in to push this brand's entry into the parent project's `brands`
  // collection. Absent or false never pushes. Needs `parent` to name the
  // relationship and DIRECTORY_SERVICE_ACCOUNT in the brand .env.
  directory: {
    // true opts the brand into the directory push. Default false:
    // participation is never implicit.
    enabled: false,
  },

  // The classy theme is what the whole dashboard is drawn in: omega-shell for
  // the geometry, omega-side__* for the sidebar, omega-statgrid for tiles.
  theme: {
    id: "classy",
    appearance: "system",
  },
  translation: {
    // Master switch (default true). Translation only runs when languages is
    // non-empty.
    enabled: true,
    // Source language code (default 'en'). Drives <html lang>, og:locale, and
    // the default hreflang.
    default: "en",
  },
  client: {
    consent: {
      // The consent banner + the provider-script gate (default true). false
      // ships NO banner: legal only for a site that loads no
      // analytics/marketing provider at all.
      enabled: true,
    },
    exitPopup: {
      // The exit-intent offer popup (default true). false ships no popup at
      // all; its copy, timeout and avatars live under client.exitPopup.config.
      enabled: true,
    },
    serviceWorker: {
      // Registers the site service worker (default true): the offline/refresh
      // lane and the push-notification registration ride it. false unregisters
      // any worker the visitor already has.
      enabled: true,
    },
  },

  // Key presence = target enabled, and every entry names its framework in
  // `type`. Web only - the tower has no backend target (its API is the plain
  // Node server in tower/, on 8693). The port keeps the family clear of its
  // siblings: playground 4000, dailybuild 4100, omega-brand 4200, tower 4300.
  targets: {
    web: {
      type: "web",
      ports: {
        website: 4300,
      },
    },
  },
}
