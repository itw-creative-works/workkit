#!/usr/bin/env bash
# workflow/identity/gh: the gh shim, linked to ~/.local/bin/gh ahead of the real
# gh. Every call but `gh auth` passes gate.js first, which may bounce it. A cloud
# session's issue, label, auth, pr and release verbs go through rest.js; elsewhere
# in a Claude session a bookkeeping verb on a rostered repo, or on the public repo
# a rostered one pairs with, runs as the workkit App (GH_TOKEN, one process) or not
# at all; the rest run the real gh as the owner. In a Claude session a write that
# succeeded leaves the gate's line in the cwd repo's gh journal.

set -uo pipefail

# The bookkeeping verbs, the `pr` subcommands that stay the owner's, and the
# reads, which post nothing and so stay the owner's under every verb.
BOT_VERBS=(issue label pr)
PR_OWNER_SUBCOMMANDS=(create merge checkout revert update-branch)
READ_SUBCOMMANDS=(list view status checks diff)

# real_path <path>: <path> with every link in its chain walked; macOS has no
# `readlink -f`, so each hop is read and joined by hand.
real_path() {
  local source="$1" target
  while [[ -L "$source" ]]; do
    target="$(readlink "$source")"
    case "$target" in
      /*) source="$target" ;;
      *)  source="$(cd "$(dirname "$source")" && pwd -P)/$target" ;;
    esac
  done
  printf '%s/%s\n' "$(cd "$(dirname "$source")" && pwd -P)" "${source##*/}"
}

SHIM="$(real_path "${BASH_SOURCE[0]}")"
KIT_DIR="$(cd "${SHIM%/*}/../.." && pwd -P)"
# norm_dir <dir>: NORM becomes <dir> as a PATH entry means it, an empty entry
# the cwd and a trailing slash dropped.
norm_dir() {
  NORM="${1:-.}"
  if [[ "$NORM" == ?*/ ]]; then NORM="${NORM%/}"; fi
}

# The folder PATH found this shim through, as PATH spells it.
OWN_DIR=.
if [[ "${BASH_SOURCE[0]}" == */* ]]; then OWN_DIR="${BASH_SOURCE[0]%/*}"; OWN_DIR="${OWN_DIR:-/}"; fi
norm_dir "$OWN_DIR"
OWN_DIR="$NORM"

# The real gh: the first gh on PATH after the shim's own folder, skipping every
# folder already met at or before it, so each hop through another shim lands
# further down PATH and none loops. Called off PATH, the whole PATH is after it.
real_gh() {
  local i own=-1 met=$'\n' dirs=()
  IFS=: read -r -a dirs <<<"${PATH:-}"
  for ((i = 0; i < ${#dirs[@]}; i++)); do
    norm_dir "${dirs[i]}"
    if [[ "$NORM" == "$OWN_DIR" ]]; then own=$i; break; fi
  done
  for ((i = 0; i <= own; i++)); do
    norm_dir "${dirs[i]}"
    met+="$NORM"$'\n'
  done
  for ((i = own + 1; i < ${#dirs[@]}; i++)); do
    norm_dir "${dirs[i]}"
    case "$met" in *$'\n'"$NORM"$'\n'*) continue ;; esac
    if [[ -f "$NORM/gh" && -x "$NORM/gh" ]]; then
      printf '%s\n' "$NORM/gh"
      return 0
    fi
  done
  return 1
}

if ! GH="$(real_gh)"; then
  printf 'gh: no gh on PATH after the workkit shim at %s\n' "$OWN_DIR/gh" >&2
  exit 127
fi

# in_list <word> <list...>: whether <word> is one of the list.
in_list() {
  local word="$1" item
  shift
  for item in "$@"; do
    [[ "$item" == "$word" ]] && return 0
  done
  return 1
}

# bot_verb <args...>: whether the call is bookkeeping. The subcommand is the
# first word after the verb that is neither a flag nor the value of `-R`/`--repo`;
# no subcommand, or `-h`/`--help` anywhere after the verb, is the owner's.
bot_verb() {
  local verb="${1:-}" arg skip=0
  in_list "$verb" "${BOT_VERBS[@]}" || return 1
  shift
  in_list -h "$@" || in_list --help "$@" && return 1
  # The subcommand rule is the twin of `subAt` in ./gate.js, shape for shape:
  # change one and change the other.
  for arg in "$@"; do
    if [[ "$skip" -eq 1 ]]; then skip=0; continue; fi
    case "$arg" in
      -R|--repo) skip=1 ;;
      -*) ;;
      *) in_list "$arg" "${READ_SUBCOMMANDS[@]}" && return 1
         [[ "$verb" == pr ]] && in_list "$arg" "${PR_OWNER_SUBCOMMANDS[@]}" && return 1
         return 0 ;;
    esac
  done
  return 1
}

# url_repo <args...>: the owner/repo of the first argument that is a github.com
# issue or pull request URL (a tail after the number allowed), whatever precedes
# it, a flag's value included, except the value of a body or title flag, which is
# prose; -R names another repo.
url_repo() {
  local arg skip=0
  for arg in "$@"; do
    if [[ "$skip" -eq 1 ]]; then skip=0; continue; fi
    case "$arg" in
      --body|-b|--body-file|-F|--title|-t) skip=1; continue ;;
    esac
    if [[ "$arg" =~ ^https://github\.com/([^/]+)/([^/]+)/(issues|pull)/[0-9]+([/?#].*)?$ ]]; then
      printf '%s/%s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
      return 0
    fi
  done
  return 1
}

# flag_repo <args...>: the first `--repo`/`-R` value in any spelling gh takes.
flag_repo() {
  local want=0 arg
  for arg in "$@"; do
    if [[ "$want" -eq 1 ]]; then printf '%s\n' "$arg"; return 0; fi
    case "$arg" in
      -R|--repo) want=1 ;;
      --repo=*) printf '%s\n' "${arg#--repo=}"; return 0 ;;
      -R?*) printf '%s\n' "${arg#-R}"; return 0 ;;
    esac
  done
  return 1
}

# repo_of <args...>: the repo a call acts on: the flag, else GH_REPO, else any
# issue or pull request URL among the arguments, else the cwd's origin; empty
# when none answers. Needs lib/slug.sh sourced.
repo_of() {
  local flag
  flag="$(flag_repo "$@")" || flag="${GH_REPO:-}"
  if [[ -n "$flag" ]]; then
    # The slug helper takes every spelling gh does (a URL, github.com/, .git); the
    # leading slash lets a bare owner/name through its path match.
    wk_slug_from_remote "/$flag"
  else
    url_repo "$@" || wk_repo_slug .
  fi
}

# names_public <folder> <owner/name lowercased>: whether the folder's committed
# `.workkit/settings.json` names that slug as its `public` repo, any letter case;
# the match wk_roster_path runs over the roster for a paired public repo.
names_public() {
  local public
  [[ -r "$1/.workkit/settings.json" ]] || return 1
  public="$(wk_jq -r '.public // empty | strings' "$1/.workkit/settings.json" 2>/dev/null)" || return 1
  [[ -n "$public" && "$(printf '%s' "$public" | tr '[:upper:]' '[:lower:]')" == "$2" ]]
}

# shellcheck source=../lib/platform.sh
. "$KIT_DIR/workflow/lib/platform.sh"
# shellcheck source=../lib/participation.sh
. "$KIT_DIR/workflow/lib/participation.sh"
# shellcheck source=../lib/slug.sh
. "$KIT_DIR/workflow/lib/slug.sh"

# One temp file holds stdin for every body the call reads from it; it is
# removed on exit, so a call that made it never ends in exec.
BODY_TMP=''
stdin_file() {
  [[ -z "$BODY_TMP" ]] || return 0
  BODY_TMP="$(mktemp "${TMPDIR:-/tmp}/workkit-gh-body.XXXXXX")" || exit 1
  trap 'rm -f "$BODY_TMP"' EXIT
  cat >"$BODY_TMP"
}

# stdin_bodies <args...>: ARGS becomes the args with each body gh would read
# from stdin (a `-` value of --body-file, -F or --input, or a field's `@-`)
# pointed at the temp file instead, so the gate can read the same body.
stdin_bodies() {
  local arg prev=''
  ARGS=()
  for arg in "$@"; do
    if [[ "$arg" == - ]] && in_list "$prev" --body-file -F --input; then
      stdin_file
      arg="$BODY_TMP"
    elif [[ "$arg" == *=@- ]] && in_list "$prev" -F --field; then
      stdin_file
      arg="${arg%-}$BODY_TMP"
    elif [[ "$arg" == --body-file=- || "$arg" == --input=- || "$arg" == --field=*=@- ]]; then
      stdin_file
      arg="${arg%-}$BODY_TMP"
    fi
    prev="$arg"
    ARGS+=("$arg")
  done
}

# journal_append: LINE as one more line of the gh journal of the cwd's repo
# root, else of the cwd; a journal that cannot take it is said, never fatal.
journal_append() {
  local root journal
  root="$(git rev-parse --show-toplevel 2>/dev/null)" || root=''
  [[ -n "$root" ]] || root="$PWD"
  wk_sweep_markers
  if journal="$(wk_marker_path claude-gh-journal "$root")" && mkdir -p "${journal%/*}" \
    && printf '%s\n' "$LINE" >>"$journal"; then
    return 0
  fi
  printf 'gh: the call ran, but the workkit gh journal could not take its line\n' >&2
}

# run_gh <command...>: the call's last step. In a Claude session it runs as a
# child, and an exit 0 appends LINE to the journal when it is set; elsewhere it
# is exec'd unless a stdin body's temp file waits to be removed.
run_gh() {
  local code
  if [[ "${CLAUDECODE:-}" != 1 && -z "$BODY_TMP" ]]; then exec "$@"; fi
  "$@"
  code=$?
  if [[ "$code" -eq 0 && -n "$LINE" && "${CLAUDECODE:-}" == 1 ]]; then journal_append; fi
  exit "$code"
}

REPO=''
LINE=''
[[ "${1:-}" == auth ]] || REPO="$(repo_of "$@")"

# The gate sees every call but `gh auth` and an identity-off one: exit 1 is a
# bounce whose text it has already put on stderr; its stdout is the journal line.
# Its session gates rule only where wk_session_judges holds, the git hooks' gate.
# Its gh reads run the real gh, handed over in git's spelling, the one Node starts on Windows.
if [[ "${WORKKIT_IDENTITY_OFF:-}" != 1 && "${1:-}" != auth ]]; then
  if [[ $# -gt 0 ]]; then
    stdin_bodies "$@"
    set -- "${ARGS[@]}"
  fi
  GATE_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || GATE_ROOT=''
  unset WORKKIT_GATE_JUDGES
  if [[ -n "$GATE_ROOT" ]] && wk_session_judges "$GATE_ROOT"; then export WORKKIT_GATE_JUDGES=1; fi
  if GATE_NODE="$(wk_node)"; then
    LINE="$(WORKKIT_REAL_GH="$(wk_native_path "$GH")" WORKKIT_GATE_REPO="$REPO" "$GATE_NODE" "$KIT_DIR/workflow/identity/gate.js" "$PWD" "$@")" || exit $?
  else
    printf 'gh: the workkit gate did not run (no node %s or newer found)\n' "$WK_NODE_FLOOR" >&2
  fi
fi

# A cloud session's proxy serves REST alone and signs every call as the account,
# so no bot token is fetched there: rest.js judges every issue, label, auth, pr
# and release call, with the real gh and the repo handed over in the environment.
# Every other verb runs the real gh given that repo, so `gh api repos/{owner}/{repo}`
# and `gh run list` name the clone's repo whatever host its proxy origin names.
if wk_is_cloud; then
  case "${1:-}" in
    issue|label|auth|pr|release)
      WORKKIT_REAL_GH="$(wk_native_path "$GH")" GH_REPO="$REPO" run_gh node "$KIT_DIR/workflow/identity/rest.js" "$@"
      ;;
  esac
  if [[ -n "$REPO" ]]; then export GH_REPO="$REPO"; fi
  run_gh "$GH" "$@"
fi

if [[ -z "${CLAUDECODE:-}" || "${WORKKIT_IDENTITY_OFF:-}" == 1 || "${1:-}" == auth ]] \
  || ! bot_verb "$@"; then
  run_gh "$GH" "$@"
fi

# Without jq the roster cannot be read, so whether the call is the bot's is unknown.
if ! command -v jq >/dev/null 2>&1; then
  printf 'gh: the workkit shim needs jq to read the roster\n' >&2
  exit 1
fi

# A rostered repo is the bot's, and so is the public repo an enabled one pairs with.
if [[ -z "$REPO" ]] || { ! wk_roster_path "$REPO" >/dev/null && ! wk_roster_path "$REPO" names_public >/dev/null; }; then
  run_gh "$GH" "$@"
fi

# The client's exit says what to do: 0 hands over the token, which travels in
# the environment only; any other code (3 not signed in, 4 the App not installed,
# 1 the rest) stops here with the client's message. Such a call never runs as you.
# Its stderr stays this terminal's, so the sign-in it starts at a keyboard reaches you.
TOKEN="$(node "$KIT_DIR/workflow/identity/token.js" "$REPO")" || exit $?
GH_TOKEN="$TOKEN" run_gh "$GH" "$@"
