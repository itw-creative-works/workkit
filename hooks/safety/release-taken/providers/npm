#!/bin/bash
# providers/npm: has the npm registry already published <name>@<version>?
# The provider contract: README.md § The provider contract (exit 1 taken, 0 free
# or cannot tell, said on stderr). stdin is closed and the update notifier off,
# so nothing holds the hook open or reaches stdout. `onRegistry` in
# workflow/ship/publish-plan.js asks the same question: change both together.

set -uo pipefail

name="${1:-}"
version="${2:-}"
[ -n "$name" ] && [ -n "$version" ] || exit 0

stand_down() {
  printf 'release-taken: the npm check stood down for %s@%s: %s\n' "$name" "$version" "$1" >&2
  exit 0
}

command -v npm >/dev/null 2>&1 || stand_down "npm is not on PATH"

err=$(mktemp "${TMPDIR:-/tmp}/release-taken-npm.XXXXXX") || stand_down "no temporary file could be made"
trap 'rm -f "$err"' EXIT

rc=0
# One try, fifteen seconds: a stalled registry stands the check down rather
# than holding the Bash command for the hook's whole window.
out=$(npm view --no-update-notifier --fetch-retries=0 --fetch-timeout=15000 "$name@$version" version </dev/null 2>"$err") || rc=$?
if [ "$rc" -ne 0 ]; then
  # E404 is the registry answering: no such package, or no such version of it.
  # Either way the version is free.
  if grep -q 'E404' "$err"; then exit 0; fi
  why=$(head -n 1 "$err" 2>/dev/null || true)
  [ -n "$why" ] || why="npm exited $rc"
  stand_down "$why"
fi

out=$(printf '%s' "$out" | tr -d '[:space:]')
[ "$out" = "$version" ] || exit 0
exit 1
